#!/usr/bin/env bash
# claude-hook-heartbeat — records that the plugin's hooks are DISPATCHED in a session.
#
#   (no args)        PreToolUse: writes <session_id>.fired
#   --session-start  SessionStart: writes <session_id>.start, only when source=startup;
#                    from a plugin-<name> root it writes <session_id>.plugin-<name>.start
#
# Records live in $HOME/.claude/claude-code-toolkit/heartbeat/ as key=value lines. This proves
# hooks fire from a given plugin root against a given hooks.json; it does not prove any
# other hook refuses anything. Always exits 0 and prints nothing: a heartbeat must never
# disturb the session it observes. No `set -e` on purpose.

exec 2>/dev/null

mode=fired
[ "${1:-}" = "--session-start" ] && mode=start

input=$(cat)

# Best-effort field extraction from the one-line JSON payload.
field() {
  printf '%s\n' "$input" |
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
}

session_id=$(field session_id)
# The id becomes a filename: anything but letters, digits and hyphen writes nothing.
case "$session_id" in
  '' | *[!A-Za-z0-9-]*) exit 0 ;;
esac

if [ "$mode" = start ]; then
  [ "$(field source)" = "startup" ] || exit 0
fi

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  plugin_root=$CLAUDE_PLUGIN_ROOT
  root_source=env
else
  plugin_root=${0%/tools/hook-heartbeat/claude-hook-heartbeat}
  root_source=path
fi

dir="${HOME:-}/.claude/claude-code-toolkit/heartbeat"
mkdir -p "$dir" || exit 0
now=$(date +%s)

# Atomic write: tmp file in the same directory, then rename; tmp removed on failure.
write_record() {
  local target=$1 body=$2 tmp="$1.tmp.$$"
  # mv would silently move the tmp file INTO a directory squatting on the name.
  if [ ! -d "$target" ] && printf '%s\n' "$body" > "$tmp" && mv -f "$tmp" "$target"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

if [ "$mode" = fired ]; then
  write_record "$dir/$session_id.fired" "fired_at=$now
plugin_root=$plugin_root
root_source=$root_source"
  exit 0
fi

hooks_json="$plugin_root/hooks/hooks.json"
hooks_sha256=
if [ -f "$hooks_json" ]; then
  if command -v sha256sum >/dev/null; then
    hooks_sha256=$(sha256sum "$hooks_json" | cut -d ' ' -f 1)
  elif command -v shasum >/dev/null; then
    hooks_sha256=$(shasum -a 256 "$hooks_json" | cut -d ' ' -f 1)
  fi
fi

# A profile plugin (plugin-build, ...) gets its own start record, so it cannot overwrite
# core's; core's root (plugin/) and any other root keep the plain name.
start_name=$session_id.start
case "$(basename "$plugin_root")" in
  plugin-*[!abcdefghijklmnopqrstuvwxyz]* | plugin-) ;;
  plugin-[a-z]*) start_name=$session_id.$(basename "$plugin_root").start ;;
esac

write_record "$dir/$start_name" "started_at=$now
plugin_root=$plugin_root
root_source=$root_source
hooks_sha256=$hooks_sha256"

# Prune records older than 30 days.
find "$dir" -type f \( -name '*.fired' -o -name '*.start' \) -mtime +30 -exec rm -f {} + >/dev/null
exit 0
