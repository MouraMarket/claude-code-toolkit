#!/usr/bin/env python3
"""Search titled Claude Code sessions.

Usage:
  csearch                 list every titled session, newest first
  csearch retry api       rows matching ALL terms (case-insensitive)
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import title_lib


def search(terms, index_path):
    """Return matching index rows, newest first.

    Every term must appear, case-insensitively, somewhere in the row (date,
    session id, working directory or title). A term matches only itself.
    """
    needles = [t.lower().strip() for t in terms]
    results = []
    try:
        with open(index_path, "r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                fields = line.rstrip("\n").split("\t")
                if len(fields) < 4:
                    continue
                date, session_id, cwd, title = fields[0], fields[1], fields[2], fields[3]
                haystack = line.lower()
                if all(n in haystack for n in needles):
                    results.append({"date": date, "session_id": session_id,
                                    "cwd": cwd, "title": title})
    except (IOError, OSError):
        return []
    results.reverse()
    results.sort(key=lambda r: r["date"], reverse=True)
    return results


def main():
    terms = sys.argv[1:]
    results = search(terms, title_lib.INDEX_PATH)
    if not results:
        if not os.path.exists(title_lib.INDEX_PATH):
            print("No session index yet at {0}".format(title_lib.INDEX_PATH))
        else:
            print("No sessions match: {0}".format(" ".join(terms)))
        return 1
    for row in results:
        print("{0}  {1}".format(row["date"], row["title"]))
        print("            claude --resume {0}".format(row["session_id"]))
    print("\n{0} session(s)".format(len(results)))
    return 0


if __name__ == "__main__":
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(encoding="utf-8", errors=_stream.errors)
        except (AttributeError, ValueError):
            pass
    sys.exit(main())
