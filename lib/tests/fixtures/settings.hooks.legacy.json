{
  "_comment": [
    "The hook wiring this repo owns. install.sh MERGES this into ~/.claude/settings.json",
    "rather than overwriting it, because that file also holds permissions, model,",
    "theme, and enabledPlugins \u2014 settings Claude Code itself rewrites, and that are",
    "machine-specific. Keys not listed here are left exactly as they were.",
    "",
    "Paths are absolute because Claude Code does not expand ~ in hook commands.",
    "install.sh substitutes $HOME for the literal __HOME__ token below."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-danger-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-worktree-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-distill-write-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-model-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-usage-dispatch",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-session-claim",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-title-session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-session-release",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-build-cost-record",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-caffeinate release",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-thread-watch",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-usage-watch",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-caffeinate acquire",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-base-pin",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-toolkit-integrity",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-harness-check --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-caffeinate settle",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-thread-deliver",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-repo-freshness",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-tooling-digest",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-memory-lint",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-toolkit-integrity",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-build-route",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-spec-archive --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-context-budget --record",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-usage-watch",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-caffeinate acquire",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-harness-check --hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-usage-subagent",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-usage-postmortem",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-caffeinate settle",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-memory-routing",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.local/bin/claude-context-growth",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "__HOME__/.local/bin/claude-usage-line",
    "refreshInterval": 30,
    "padding": 0
  }
}
