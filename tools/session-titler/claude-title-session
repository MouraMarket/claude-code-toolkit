#!/usr/bin/env python3
"""SessionEnd hook: title the session that just ended.

Two modes:
  (no args)   hook entry — parse stdin, fork a detached worker, exit 0 fast
  --worker    the detached worker — sample, generate, write

SessionEnd blocks session teardown, so the entry path must never wait on a
model call. Everything is best-effort: this exits 0 on every failure path.
"""

import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import title_lib

GUARD_ENV = "CLAUDE_TITLE_HOOK"
MODEL = "haiku"
GENERATION_TIMEOUT = 90


def generate_title(sample, cwd, timeout=GENERATION_TIMEOUT):
    """Ask Haiku for a title via headless Claude Code.

    The child inherits GUARD_ENV=1, so the session it creates will not
    recursively trigger this hook.
    """
    prompt = title_lib.build_prompt(sample, cwd)
    env = dict(os.environ)
    env[GUARD_ENV] = "1"
    # A title needs no memory, and skipping it saves tokens.
    env["CLAUDE_CODE_DISABLE_AUTO_MEMORY"] = "1"
    try:
        # --no-session-persistence: without it the titling call is saved as a
        # session of its own. Claude Code then gives that ghost an AI title of
        # its own, and it sorts above the real session in history search.
        proc = subprocess.run(
            ["claude", "-p", "--model", MODEL, "--no-session-persistence"],
            input=prompt, env=env, capture_output=True, text=True, encoding="utf-8",
            timeout=timeout,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        title_lib.log("generate_title failed: {0}".format(exc))
        return None
    if proc.returncode != 0:
        title_lib.log("claude -p exited {0}: {1}".format(
            proc.returncode, (proc.stderr or "")[:300]))
        return None
    return title_lib.clean_title(proc.stdout)


def run_worker(session_id, transcript_path, cwd):
    """Sample, generate, persist. Always returns 0."""
    try:
        sample = title_lib.sample_transcript(transcript_path)
        if not title_lib.is_titleworthy(sample):
            title_lib.log("skipped {0}: only {1} real user message(s)".format(
                session_id, sample.get("user_count", 0)))
            return 0
        if title_lib.has_title(transcript_path):
            title_lib.log("skipped {0}: already titled".format(session_id))
            return 0

        title = generate_title(sample, cwd)
        if not title:
            title_lib.log("no title produced for {0}".format(session_id))
            return 0

        # The index row only follows a title the transcript really carries:
        # a row without its record would make csearch return a title the
        # session never got. A failed append leaves the session untitled, so
        # the next backfill (which skips titled sessions) retries it.
        if not title_lib.append_title_record(transcript_path, session_id, title):
            title_lib.log("not indexed {0}: title record not written".format(
                session_id))
            return 0
        title_lib.append_index_row(session_id, cwd, title)
        title_lib.log("titled {0}: {1}".format(session_id, title))
    except Exception as exc:  # never let a titling bug disrupt a session
        title_lib.log("worker error for {0}: {1}".format(session_id, exc))
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--worker":
        if len(sys.argv) < 5:
            return 0
        return run_worker(sys.argv[2], sys.argv[3], sys.argv[4])

    # Primary recursion guard: the headless session we spawn must not title.
    if os.environ.get(GUARD_ENV) == "1":
        return 0

    if not title_lib.is_enabled():
        return 0

    try:
        payload = json.loads(sys.stdin.buffer.read())
    except Exception:
        return 0
    if not isinstance(payload, dict):
        return 0

    session_id = payload.get("session_id") or ""
    transcript_path = payload.get("transcript_path") or ""
    cwd = payload.get("cwd") or ""
    if not session_id or not transcript_path:
        return 0

    # Detach so session teardown is never delayed by a model call.
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--worker",
             session_id, transcript_path, cwd],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            env=dict(os.environ),
        )
    except Exception as exc:
        title_lib.log("failed to spawn worker: {0}".format(exc))
    return 0


if __name__ == "__main__":
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(encoding="utf-8", errors=_stream.errors)
        except (AttributeError, ValueError):
            pass
    sys.exit(main())
