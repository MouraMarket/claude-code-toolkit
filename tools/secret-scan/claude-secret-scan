#!/usr/bin/env python3
"""Block credentials from reaching git history.

Runs as a global git pre-commit hook, and by hand:

    claude-secret-scan                 # staged changes (what the hook runs)
    claude-secret-scan --all           # every tracked file in this repo
    claude-secret-scan path/to/file    # specific paths

Exit codes: 0 clean, 1 findings, 2 could not scan.

## Why this one fails CLOSED, when the danger guard fails open

CLAUDE.md is explicit that claude-danger-guard fails open, and that the
asymmetry is deliberate: a guard that misfires on ordinary work gets disabled,
and a disabled guard protects nothing. That reasoning is about *matches* and it
holds here too — hence prefix-anchored patterns and no entropy heuristics.

It does not hold for *internal errors*, because the harm is shaped differently.
A destructive command the guard waves through is bounded and visible; you can
see what got deleted. A credential committed to git history is permanent,
already pushed to GitHub by the time anyone notices, and is only really fixed by
rotating the credential. So if this tool cannot complete a scan, it blocks the
commit rather than guessing, and prints the one-line bypass so being wrong costs
five seconds:

    git commit --no-verify

That bypass is intentional and not a hole. Somebody who types it has decided;
somebody who never learns the check silently stopped running has not.
"""

import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))  # realpath: run via symlink

# The rule table comes from tools/leak-gate (see secret_lib). If it cannot load,
# this is the "could not scan" case, so exit 2 like any other incomplete scan.
# An uncaught ImportError would exit 1, which reads as "credentials found".
try:
    import secret_lib  # noqa: E402
except Exception as _import_error:  # noqa: BLE001 — any failure means no rules
    print("secret-scan could not load its rules: %s" % _import_error, file=sys.stderr)
    print("Blocking rather than scanning with no rules. To proceed anyway:", file=sys.stderr)
    print("    git commit --no-verify", file=sys.stderr)
    sys.exit(2)

# Never scan these. Lockfiles and minified bundles are long strings of
# high-entropy characters that no prefix rule should match anyway, but reading a
# 4MB lockfile on every commit is a cost with no benefit.
SKIP_SUFFIXES = (
    ".lock", ".min.js", ".min.css", ".map", ".pyc", ".so", ".dylib",
    ".png", ".jpg", ".jpeg", ".gif", ".pdf", ".zip", ".gz", ".woff", ".woff2",
)
SKIP_DIRS = ("node_modules/", ".git/", "__pycache__/", "dist/", "build/")
MAX_BYTES = 2_000_000


def skipped(path):
    if any(part in path for part in SKIP_DIRS):
        return True
    return path.lower().endswith(SKIP_SUFFIXES)


def read(path):
    """File contents, or None for a file there is deliberately nothing to scan in.

    None means exactly three things: over MAX_BYTES, binary, or gone from disk.
    A tracked file deleted in the working tree has no content to scan, and its
    removal is not a credential problem. Anything else that stops us reading —
    permission denied, a directory, an I/O error — RAISES, because None reads as
    "scanned and clean" and an unreadable file was not scanned. scan_paths turns
    the raise into an incomplete result.

    A decode failure is NOT a reason to skip. Every rule in secret_lib is pure
    ASCII, so `errors="replace"` leaves any credential in the file byte-for-byte
    intact and the scan still finds it. Returning None on a latin-1 note or a CSV
    with a stray 0x92 smart quote dropped it from `--all` silently, and `--all`
    is the CI backstop whose green is read as "no credentials are tracked". The
    same replacement is applied to git's diff output in scan_staged, so the
    pre-commit hook can scan that file class too instead of failing closed on a
    codec error.
    """
    try:
        if os.path.getsize(path) > MAX_BYTES:
            return None
        with open(path, "rb") as handle:
            raw = handle.read()
    except FileNotFoundError:
        return None
    if b"\0" in raw[:8192]:  # binary
        return None
    return raw.decode("utf-8", errors="replace")


def scan_staged():
    # The flags pin what the parser reads: a user's diff.external or textconv
    # driver would rewrite the diff, and diff.noprefix / diff.mnemonicPrefix
    # would change the `a/` `b/` path prefixes. Bytes mode, not text=True: text mode
    # translates an embedded \r to \n, which strips the `+` from the tail of
    # an added line before scan_diff sees it.
    result = subprocess.run(
        ("git", "-c", "core.quotePath=false", "diff", "--cached", "--no-color",
         "--no-ext-diff", "--no-textconv", "--src-prefix=a/", "--dst-prefix=b/", "-U0"),
        capture_output=True, timeout=30,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.decode("utf-8", errors="replace").strip()
                           or "git diff --cached failed")
    return secret_lib.scan_diff(result.stdout.decode("utf-8", errors="replace")), []


def scan_paths(paths):
    """Returns (findings, unreadable); unreadable is [(path, reason)].

    An unreadable file does not stop the sweep: the rest is still scanned, so
    findings elsewhere are not hidden behind it.
    """
    findings = []
    unreadable = []
    for path in paths:
        if skipped(path):
            continue
        try:
            text = read(path)
        except (OSError, ValueError) as error:
            unreadable.append((path, getattr(error, "strerror", None) or str(error)))
            continue
        if text is None:
            continue
        findings.extend(secret_lib.scan_text(text, path))
    return findings, unreadable


def tracked_files():
    """Tracked paths from `git ls-files -z -s`, exact bytes, one per path.

    Newline-delimited `git ls-files` C-quotes non-ASCII, tab, newline and quote
    characters, and the quoted literal then fails to open. -z prints paths
    verbatim. Bytes mode, so nothing translates or strictly decodes them.
    """
    result = subprocess.run(("git", "ls-files", "-z", "-s"), capture_output=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.decode("utf-8", errors="replace").strip()
                           or "not a git repository")
    records = [r for r in result.stdout.split(b"\0") if r]
    # A sweep that examined nothing is a failure, not a clean repo — the same
    # trap ci/local-checks.sh guards with its `ran == 0` check. This is the CI backstop:
    # green here is read as "no credentials are tracked", and it must not be
    # reachable by scanning zero files.
    if not records:
        raise RuntimeError("no tracked files found — wrong directory, or not a git repository")
    paths = []
    seen = set()
    for record in records:
        meta, _, raw_path = record.partition(b"\t")
        # A gitlink is another repository and a symlink's target is scanned in
        # its own right if tracked: neither has file content of ours to read.
        if meta.split()[0] in (b"160000", b"120000"):
            continue
        path = os.fsdecode(raw_path)
        if path not in seen:  # a conflicted path appears once per stage
            seen.add(path)
            paths.append(path)
    return paths


def scan_all():
    return scan_paths(tracked_files())


def report_unreadable(unreadable):
    print("", file=sys.stderr)
    print("secret-scan could not read %d file(s), so this scan is incomplete:"
          % len(unreadable), file=sys.stderr)
    for path, reason in unreadable[:20]:
        # repr: a newline in a file name must not forge an output line.
        print("  %r: %s" % (path, reason), file=sys.stderr)
    if len(unreadable) > 20:
        print("  … and %d more" % (len(unreadable) - 20), file=sys.stderr)
    print("Blocking rather than reporting a clean scan. To proceed anyway:", file=sys.stderr)
    print("    git commit --no-verify", file=sys.stderr)


def report(findings):
    print("", file=sys.stderr)
    print("BLOCKED: %d credential%s found in what you are committing."
          % (len(findings), "" if len(findings) == 1 else "s"), file=sys.stderr)
    print("", file=sys.stderr)
    for finding in findings:
        print(finding.format(), file=sys.stderr)
    print("", file=sys.stderr)
    print("The value itself is not printed — it would end up in your scrollback.",
          file=sys.stderr)
    print("", file=sys.stderr)
    print("Fix it by replacing the literal with a reference:", file=sys.stderr)
    print("    $ENV_VAR                     set outside the repo, read at runtime", file=sys.stderr)
    print("    a secret manager reference   resolved at runtime, never stored", file=sys.stderr)
    print("", file=sys.stderr)
    print("If this is genuinely not a secret — a docs example, a fixture —", file=sys.stderr)
    print('add a comment containing "%s" on that line.' % secret_lib.ALLOW_MARKER,
          file=sys.stderr)
    print("", file=sys.stderr)
    print("If the credential was ever pushed, rotate it. Removing the line does",
          file=sys.stderr)
    print("not remove it from history.", file=sys.stderr)


USAGE = """usage: claude-secret-scan [--staged | --all | PATH...]

  --staged    scan what is staged for commit (the default, and what the
              pre-commit hook runs)
  --all       scan every tracked file in the repository
  PATH...     scan the named files
  -h, --help  this message

Exit: 0 clean, 1 credentials found, 2 could not complete.
"""


def main(argv):
    args = [a for a in argv[1:] if a != "--staged"]

    if "--help" in args or "-h" in args:
        print(USAGE, end="")
        return 0

    # Anything option-shaped that is not ours is an error, not a filename.
    #
    # Falling through to `scan_paths` would be wrong: there a nonexistent path is
    # indistinguishable from a deliberately skipped one: `read()` returns None
    # for the OSError, so the tool would print nothing and exit 0. That
    # would make `--help`, and any typo such as `--all-files`, a silent clean pass.
    #
    # It matters because ci/local-checks.sh invokes `--all` by name as the CI backstop.
    # A rename or a typo there would have turned that job green while scanning
    # nothing at all — precisely the "green run that executed nothing" failure
    # this repo guards against elsewhere, inside the tool meant to be the guard.
    unknown = [a for a in args if a.startswith("-") and a != "--all"]
    if unknown:
        print("secret-scan: unrecognised option: %s" % " ".join(unknown), file=sys.stderr)
        print("", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        return 2

    # An explicitly named path that is not there is a mistake worth reporting.
    # Silent skipping is right for a sweep (binary, oversized, generated) and
    # wrong for a file someone asked for by name.
    if "--all" not in args and args:
        missing = [p for p in args if not os.path.exists(p)]
        if missing:
            print("secret-scan: no such file: %s" % " ".join(missing), file=sys.stderr)
            print("Blocking rather than reporting a clean scan of nothing.", file=sys.stderr)
            return 2

    try:
        if "--all" in args:
            findings, unreadable = scan_all()
        elif args:
            findings, unreadable = scan_paths(args)
        else:
            findings, unreadable = scan_staged()
    except Exception as error:  # noqa: BLE001 — see the module docstring
        print("secret-scan could not complete: %s" % error, file=sys.stderr)
        print("Blocking rather than guessing. To proceed anyway:", file=sys.stderr)
        print("    git commit --no-verify", file=sys.stderr)
        return 2

    if findings:
        report(findings)
        if unreadable:
            report_unreadable(unreadable)
        return 1
    if unreadable:
        report_unreadable(unreadable)
        return 2
    return 0


if __name__ == "__main__":
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(encoding="utf-8", errors=_stream.errors)
        except (AttributeError, ValueError):
            pass
    sys.exit(main(sys.argv))
